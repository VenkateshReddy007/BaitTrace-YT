SUPABASE_URL=
SUPABASE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter API Key — shared between all OpenRouter-billed models
OPENROUTER_API_KEY=

# Jev classifier model (TypeSafe Decisions API via OpenRouter)
# Pin to a versioned model for reproducibility. The alias
# ~typesafe/jev-latest tracks whatever TypeSafe ships next —
# only use it if you intentionally want to track bleeding-edge releases.
JEV_MODEL=typesafe/jev-1.13

# Classifier provider: "jev" (default) or "gemini" (original all-Gemini path)
CLASSIFIER_PROVIDER=jev

# Jev per-sweep budget caps
JEV_LLM_CALL_BUDGET=300
JEV_COST_CEILING_PER_SWEEP=0.50
